{
  "name": "autoradar",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:e2e": "pnpm --filter @autoradar/web test:e2e",
    "clean:cache": "node -e \"const fs=require('node:fs'); for (const path of ['.turbo','apps/web/.next','apps/web/.turbo','actors/search/.turbo','packages/domain/.turbo','packages/ui/.turbo']) fs.rmSync(path,{recursive:true,force:true})\"",
    "supabase:start": "pnpm dlx supabase@latest start",
    "supabase:reset": "pnpm dlx supabase@latest db reset",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "actor:dev": "pnpm --filter @autoradar/search-actor dev",
    "actor:test": "pnpm --filter @autoradar/search-actor test",
    "armtek:smoke": "pnpm --filter @autoradar/search-actor armtek:smoke",
    "auto1:smoke": "pnpm --filter @autoradar/search-actor auto1:smoke",
    "davinagaz:smoke": "pnpm --filter @autoradar/search-actor davinagaz:smoke",
    "motorland:smoke": "pnpm --filter @autoradar/search-actor motorland:smoke",
    "remzona:discover": "pnpm --filter @autoradar/search-actor remzona:discover",
    "remzona:smoke": "pnpm --filter @autoradar/search-actor remzona:smoke",
    "zap:smoke": "pnpm --filter @autoradar/search-actor zap:smoke"
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.6",
    "typescript": "^5.9.2"
  }
}
