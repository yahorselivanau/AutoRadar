# Public
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server
SUPABASE_SECRET_KEY=
SUPABASE_DB_URL=
APIFY_TOKEN=
APIFY_SEARCH_ACTOR_ID=
APIFY_WEBHOOK_SECRET=

# AI
AI_PROVIDER=gateway
AI_MODEL=openai/gpt-5.4-nano
# Optional outside Vercel. Vercel deployments use automatic OIDC.
AI_GATEWAY_API_KEY=

# Search
SEARCH_MAX_SOURCES=10
SEARCH_ADAPTER_CONCURRENCY=4
SEARCH_ADAPTER_TIMEOUT_MS=10000
SEARCH_TOTAL_TIMEOUT_MS=25000

# Source flags
SOURCE_ARMTEK_ENABLED=false
SOURCE_AUTO1_ENABLED=false
SOURCE_AV_PARTS_ENABLED=false
SOURCE_DAVINAGAZ_ENABLED=false
DAVINAGAZ_PLAYWRIGHT_FALLBACK_ENABLED=true
DAVINAGAZ_PLAYWRIGHT_TIMEOUT_MS=25000
SOURCE_MOTORLAND_ENABLED=true
SOURCE_REMZONA_ENABLED=true
SOURCE_ZAP_ENABLED=true

# Staged MVP rollout. Set an individual flag to false for a quick rollback.
FEATURE_DETERMINISTIC_INTENT=true
FEATURE_VIN_RESOLVER=true
FEATURE_SOURCE_SEARCH_PLANNER=true
FEATURE_SYMPTOM_DIALOGUE=true

# Armtek.by allowed public JSON search (server-only)
ARMTEK_BASE_URL=https://armtek.by/
# Required when SOURCE_ARMTEK_ENABLED=true; do not commit the value.
ARMTEK_GUEST_AUTH_TOKEN=
ARMTEK_USER_AGENT=AutoRadar/0.1 (+https://autoradar.vercel.app; parts search)
ARMTEK_HTTP_TIMEOUT_MS=12000
ARMTEK_REQUEST_INTERVAL_MS=1500
ARMTEK_RESULT_LIMIT=30
# Manual only; live smoke exits without network unless true.
ARMTEK_LIVE_SMOKE=false

# Auto1.by public SSR text search (server-only)
AUTO1_BASE_URL=https://auto1.by/
AUTO1_USER_AGENT=AutoRadar/0.1 (+https://autoradar.vercel.app; parts search)
AUTO1_HTTP_TIMEOUT_MS=10000
AUTO1_REQUEST_INTERVAL_MS=1000
AUTO1_RESULT_LIMIT=30
# Manual only; live smoke exits without network unless true.
AUTO1_LIVE_SMOKE=false

# Motorland.by public SSR text search (server-only)
MOTORLAND_BASE_URL=https://motorland.by/
MOTORLAND_USER_AGENT=AutoRadar/0.1 (+https://autoradar.vercel.app; parts search)
MOTORLAND_HTTP_TIMEOUT_MS=10000
MOTORLAND_REQUEST_INTERVAL_MS=1000
MOTORLAND_RESULT_LIMIT=30
# Manual only; live smoke exits without network unless true.
MOTORLAND_LIVE_SMOKE=false

# Remzona public XHR transport (server-only)
REMZONA_BASE_URL=https://remzona.by/
REMZONA_USER_AGENT=AutoRadar/0.1 (+https://autoradar.vercel.app; parts search)
REMZONA_HTTP_TIMEOUT_MS=10000
REMZONA_REQUEST_INTERVAL_MS=5000
REMZONA_PLAYWRIGHT_FALLBACK_ENABLED=false
# Manual only; live smoke exits without network unless true.
REMZONA_LIVE_SMOKE=false

# Zap.by allowed public SSR catalogue transport (server-only)
ZAP_BASE_URL=https://zap.by/
ZAP_USER_AGENT=AutoRadar/0.1 (+https://autoradar.vercel.app; parts search)
ZAP_HTTP_TIMEOUT_MS=10000
ZAP_REQUEST_INTERVAL_MS=500
ZAP_RESULT_LIMIT=50
ZAP_ENRICH_LIMIT=12
# Temporary private-MVP mode. Must be false before public production.
ZAP_EXPERIMENTAL_SEARCH_ENABLED=true
# Manual only; live smoke exits without network unless true.
ZAP_LIVE_SMOKE=false

# Security
SEARCH_JOB_SIGNING_SECRET=
ANON_SESSION_SECRET=
VEHICLE_DATA_ENCRYPTION_KEY=

# Guest value-first limits (rolling 24 hours)
GUEST_SEARCH_LIMIT_24H=5
GUEST_AI_REQUEST_LIMIT_24H=5
