{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "AI_MODEL",
    "AI_PROVIDER",
    "ANON_SESSION_SECRET",
    "APIFY_SEARCH_ACTOR_ID",
    "APIFY_TOKEN",
    "NEXT_PUBLIC_APP_URL",
    "NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY",
    "NEXT_PUBLIC_SUPABASE_URL",
    "SEARCH_JOB_SIGNING_SECRET",
    "SUPABASE_SECRET_KEY",
    "VEHICLE_DATA_ENCRYPTION_KEY",
    "SOURCE_ARMTEK_ENABLED",
    "SOURCE_AUTO1_ENABLED",
    "SOURCE_MOTORLAND_ENABLED",
    "SOURCE_REMZONA_ENABLED",
    "SOURCE_ZAP_ENABLED",
    "ARMTEK_BASE_URL",
    "ARMTEK_GUEST_AUTH_TOKEN",
    "ARMTEK_USER_AGENT",
    "ARMTEK_HTTP_TIMEOUT_MS",
    "ARMTEK_REQUEST_INTERVAL_MS",
    "ARMTEK_RESULT_LIMIT",
    "AUTO1_BASE_URL",
    "AUTO1_USER_AGENT",
    "AUTO1_HTTP_TIMEOUT_MS",
    "AUTO1_REQUEST_INTERVAL_MS",
    "AUTO1_RESULT_LIMIT",
    "MOTORLAND_BASE_URL",
    "MOTORLAND_USER_AGENT",
    "MOTORLAND_HTTP_TIMEOUT_MS",
    "MOTORLAND_REQUEST_INTERVAL_MS",
    "MOTORLAND_RESULT_LIMIT",
    "REMZONA_BASE_URL",
    "REMZONA_USER_AGENT",
    "REMZONA_HTTP_TIMEOUT_MS",
    "REMZONA_REQUEST_INTERVAL_MS",
    "REMZONA_PLAYWRIGHT_FALLBACK_ENABLED",
    "ZAP_BASE_URL",
    "ZAP_USER_AGENT",
    "ZAP_HTTP_TIMEOUT_MS",
    "ZAP_REQUEST_INTERVAL_MS",
    "ZAP_RESULT_LIMIT",
    "ZAP_ENRICH_LIMIT",
    "ZAP_EXPERIMENTAL_SEARCH_ENABLED"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    }
  }
}
